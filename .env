TARGET_GROUP_ID=
# Nama grup (referensi saja, bukan dipakai untuk filter): grup sales pt
LOG_TO_FILE=true
OCR_LANGUAGE=ind+eng

# ==== Google Sheets (PIC tracking) — via Apps Script Web App ====
# URL hasil deploy Web App (Deploy > New deployment > Web app)
GOOGLE_SHEETS_WEBAPP_URL=
# Token rahasia — harus SAMA dengan WEBAPP_TOKEN di apps-script/Code.gs
GOOGLE_SHEETS_WEBAPP_TOKEN=
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SHEET_TAB_LEADS=Sheet5
# Kata trigger klaim, case-insensitive, pisahkan koma
OK_KEYWORDS=ok,oke,siap,ready
# Nomor kadaluarsa kalau tak diklaim dalam durasi ini (menit, 0 = tanpa kadaluarsa)
CLAIM_WINDOW_MINUTES=30
