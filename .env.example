# ====== SALIN FILE INI MENJADI .env DAN ISI NILAI RIL ======
# JANGAN commit .env asli (sudah di-ignore). Commit hanya .env.example ini.

# ==== WhatsApp ====
# ID grup WA target, contoh: 120363021369281320@g.us
TARGET_GROUP_ID=

# true = log juga ditulis ke logs/YYYY-MM-DD.log
LOG_TO_FILE=true

# Bahasa OCR Tesseract, contoh: ind+eng (Indonesia + English)
OCR_LANGUAGE=ind+eng

# ==== Google Sheets (PIC tracking) — via Apps Script Web App ====
# URL hasil deploy Web App (Deploy > New deployment > Web app)
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec

# Token rahasia — harus SAMA dengan WEBAPP_TOKEN / filter doPost di Apps Script
GOOGLE_SHEETS_WEBAPP_TOKEN=wa-sheet-<ISI_TOKEN_RAHASIA>

# Nama tab spreadsheet
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SHEET_TAB_LEADS=Sheet5

# ==== Klaim ====
# Kata trigger klaim, case-insensitive, pisahkan koma
OK_KEYWORDS=ok,oke,siap,ready

# Nomor kadaluarsa kalau tak diklaim dalam durasi ini (menit, 0 = tanpa kadaluarsa)
CLAIM_WINDOW_MINUTES=30
